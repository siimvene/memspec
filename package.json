{
  "name": "memspec",
  "version": "0.14.0",
  "description": "Structured memory for AI agents - spec plus CLI",
  "type": "module",
  "bin": {
    "memspec": "dist/cli.js",
    "memspec-mcp": "dist/mcp.js",
    "memspec-dream": "scripts/dream.sh"
  },
  "files": [
    "dist",
    "hooks",
    "scripts/dream.sh",
    "scripts/fanout-metric.mjs",
    "bin/repair-inferred-conflicts.mjs",
    "bin/repair-scope-backfill.mjs",
    "AGENTS-ADDON.md",
    "SPEC.md",
    "MIGRATION-v0.3.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test test/**/*.test.ts",
    "repair:conflicts": "node bin/repair-inferred-conflicts.mjs",
    "repair:scope-backfill": "node bin/repair-scope-backfill.mjs",
    "schema": "node --import tsx scripts/generate-schema.ts",
    "schema:check": "node --import tsx scripts/generate-schema.ts /tmp/memspec-schema-check.md && diff -u SCHEMA.md /tmp/memspec-schema-check.md",
    "check": "npm run build && npm run schema:check && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "specification",
    "cli",
    "mcp"
  ],
  "author": "Siim Vene",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siimvene/memspec.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
